rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fix: Gate all read/write access on request.auth != null so authenticated sessions can list and update plans without UID mismatch errors
    match /users/{userId} {
      allow read, write: if request.auth != null;

      match /plans/{planId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
